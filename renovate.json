{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePatch"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "The Compose Gradle plugin is published before its libraries reach Maven Central; wait so the PR resolves",
      "matchDepNames": ["/^org\\.jetbrains\\.compose/"],
      "minimumReleaseAge": "2 days"
    }
  ]
}
