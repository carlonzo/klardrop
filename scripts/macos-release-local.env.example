# Copy to scripts/macos-release-local.env (gitignored) and fill in.
# Same values as the GitHub Actions secrets used by the macOS release jobs.

# Developer ID Application cert, exported as .p12 then base64'd:
#   base64 -i DeveloperID.p12 | pbcopy
MACOS_CERTIFICATE_P12_BASE64=
MACOS_CERTIFICATE_PASSWORD=

# App Store Connect API key (.p8), base64'd, plus its key id and issuer id:
APPSTORE_API_KEY_P8_BASE64=
APPSTORE_API_KEY_ID=
APPSTORE_API_ISSUER_ID=

# Apple team id (defaults to D7T5425WSW if unset)
APPLE_TEAM_ID=D7T5425WSW
