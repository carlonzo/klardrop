{
  "realm": "klardrop",
  "enabled": true,
  "displayName": "Klardrop",
  "registrationAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "klardrop-device-registry",
      "name": "Klardrop Device Registry API",
      "description": "Audience for ID tokens validated by the device-registry.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "1800"
      }
    },
    {
      "clientId": "klardrop-app",
      "name": "Klardrop Mobile / Desktop App",
      "description": "Public PKCE client used by Android, iOS, macOS and JVM apps to log in.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "klardrop://auth/callback",
        "http://localhost:*/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "klardrop://*"
      },
      "protocolMappers": [
        {
          "name": "audience-device-registry",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "klardrop-device-registry",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
