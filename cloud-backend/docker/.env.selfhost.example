# Copy to .env before running docker-compose -f docker-compose.selfhost.yml up
#
# Only INTERNAL_SHARED_SECRET, BROKER_JWT_SECRET, JWT_SECRET, EMQX_API_KEY,
# EMQX_API_SECRET have security impact in dev. The Postgres/Redis/Keycloak
# admin defaults are wide-open on purpose for local-only deployment.

APP_ENV=development

# Postgres
POSTGRES_PASSWORD=klardrop123

# Keycloak
KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=kc-admin

# Klardrop control-plane secrets
JWT_SECRET=dev-session-secret-change-me
BROKER_JWT_SECRET=dev-broker-secret-change-me
INTERNAL_SHARED_SECRET=internal-dev-secret

# EMQX admin API (create these in the EMQX dashboard at http://localhost:18083)
EMQX_API_KEY=emqx-api-key-change-me
EMQX_API_SECRET=emqx-api-secret-change-me
