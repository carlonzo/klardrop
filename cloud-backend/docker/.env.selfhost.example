# Copy to .env before running docker-compose -f docker-compose.selfhost.yml up
#
# Only INTERNAL_SHARED_SECRET, BROKER_JWT_SECRET, JWT_SECRET have security
# impact in dev. The Postgres/Redis/Keycloak admin defaults are wide-open on
# purpose for local-only deployment.

APP_ENV=development

# Postgres
POSTGRES_PASSWORD=klardrop123

# Keycloak
KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=kc-admin

# Klardrop control-plane secrets
JWT_SECRET=dev-session-secret-change-me
BROKER_JWT_SECRET=dev-broker-secret-change-me

# Shared secret for the Mosquitto -> device-registry webhook calls.
# Mosquitto sends it as `Authorization: Bearer <secret>`; device-registry
# rejects calls without it. Rotate per deployment.
INTERNAL_SHARED_SECRET=internal-dev-secret
