headers = openssl/ssl.h openssl/err.h openssl/x509.h openssl/evp.h openssl/bio.h openssl/types.h
headerFilter = openssl/ssl.h openssl/evp.h openssl/x509.h openssl/err.h openssl/bio.h openssl/types.h
package = com.carlom.klardrop.common.qrshare.openssl
# Debian/Ubuntu keep the arch-specific half of glibc (bits/*) and OpenSSL's opensslconf.h
# under /usr/include/<triplet>, which the interop clang never searches on its own: without
# these the index dies with "openssl/opensslconf.h file not found". The triplet is per
# target: linuxArm64 is cross-compiled from an x64 host, and searching the x86_64 include
# dir first would bake that arch's opensslconf.h into the arm64 bindings.
compilerOpts = -I/usr/include
compilerOpts.linux_x64 = -I/usr/include/x86_64-linux-gnu
compilerOpts.linux_arm64 = -I/usr/include/aarch64-linux-gnu
# --allow-shlib-undefined: this library comes from the host, and the host's glibc is newer
# than the one Kotlin/Native links against, so it references symbol versions konan's sysroot
# does not have. They resolve at load time against the host's libc. It lives here rather
# than in a per-module `linkerOpts` so every consumer gets it — including the test binaries
# of modules that only reach OpenSSL through :klardrop-common.
# The -L triplet paths are the link-time counterpart of the include paths above; see
# the note in avahi.def. Without them a Debian/Ubuntu link fails with
# "unable to find library -lssl". Each target searches only its own triplet.
linkerOpts = -L/usr/lib -L/usr/lib64 --allow-shlib-undefined
linkerOpts.linux_x64 = -L/usr/lib/x86_64-linux-gnu -lssl -lcrypto
linkerOpts.linux_arm64 = -L/usr/lib/aarch64-linux-gnu -lssl -lcrypto
