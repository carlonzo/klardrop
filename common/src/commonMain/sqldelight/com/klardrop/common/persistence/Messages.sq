CREATE TABLE messages_db (
  id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
  sender_device_id TEXT NOT NULL,
  receiver_device_id TEXT NOT NULL,
  message_type INTEGER NOT NULL,
  timestamp INTEGER NOT NULL,
  payload BLOB NOT NULL
);

CREATE INDEX message_id ON messages_db(id);

select_by_sender_device_id:
    SELECT * FROM messages_db
    WHERE sender_device_id = :device_id
    ORDER BY timestamp DESC
    LIMIT :limit OFFSET :offset;

select_by_receiver_device_id:
    SELECT * FROM messages_db
    WHERE receiver_device_id = :device_id
    ORDER BY timestamp DESC
    LIMIT :limit OFFSET :offset;

select_by_device_id:
    SELECT * FROM messages_db
    WHERE receiver_device_id = :receiver_device_id
    OR sender_device_id = :sender_device_id
    ORDER BY timestamp DESC
    LIMIT :limit OFFSET :offset;

insert_message:
    INSERT OR FAIL INTO messages_db
    (sender_device_id, receiver_device_id, message_type, timestamp, payload)
    VALUES (:sender_device_id,:receiver_device_id, :message_type, :timestamp, :payload);

delete_message:
    DELETE FROM messages_db
    WHERE messages_db.id = :id;