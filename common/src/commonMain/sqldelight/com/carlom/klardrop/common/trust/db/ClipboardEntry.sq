-- Clipboard Entries table for sync
CREATE TABLE clipboard_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    device_id TEXT NOT NULL,
    content TEXT NOT NULL,
    content_hash TEXT NOT NULL, -- To detect duplicates
    timestamp INTEGER NOT NULL,
    signature BLOB NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0
);

-- Create index for faster queries
CREATE INDEX idx_clipboard_timestamp ON clipboard_entries(timestamp DESC);
CREATE INDEX idx_clipboard_hash ON clipboard_entries(content_hash);

-- Insert clipboard entry
insertClipboardEntry:
INSERT INTO clipboard_entries (device_id, content, content_hash, timestamp, signature)
VALUES (?, ?, ?, ?, ?);

-- Get latest clipboard entry
getLatestClipboardEntry:
SELECT * FROM clipboard_entries ORDER BY timestamp DESC LIMIT 1;

-- Get unsynced entries
getUnsyncedClipboardEntries:
SELECT * FROM clipboard_entries WHERE synced = 0 ORDER BY timestamp ASC;

-- Mark as synced
markClipboardEntrySynced:
UPDATE clipboard_entries SET synced = 1 WHERE id = ?;

-- Check if content exists
contentExists:
SELECT COUNT(*) > 0 AS exists FROM clipboard_entries WHERE content_hash = ?;

-- Clean old entries (keep last N entries)
cleanOldClipboardEntries:
DELETE FROM clipboard_entries WHERE id NOT IN (
    SELECT id FROM clipboard_entries ORDER BY timestamp DESC LIMIT ?
);