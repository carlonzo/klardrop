CREATE TABLE messages (
    id INTEGER AS Int PRIMARY KEY AUTOINCREMENT,
    remote_device_id TEXT NOT NULL,
    content TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    is_sender INTEGER AS Boolean NOT NULL,
    message_type TEXT NOT NULL, -- Enum: TEXT, FILE
    file_transfer_id INTEGER,
    FOREIGN KEY(file_transfer_id) REFERENCES file_transfers(id)
);

CREATE TABLE file_transfers (
    id INTEGER AS Int PRIMARY KEY AUTOINCREMENT,
    file_name TEXT NOT NULL,
    file_path TEXT NOT NULL,
    total_size INTEGER NOT NULL,
    transferred_size INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL -- Enum: IN_PROGRESS, COMPLETED, FAILED
);

-- Queries for messages table
insert:
INSERT INTO messages (remote_device_id, content, timestamp, is_sender, message_type, file_transfer_id)
VALUES (?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

getMessagesForDevice:
SELECT *
FROM messages
WHERE remote_device_id = ?
ORDER BY timestamp DESC
LIMIT ?;

-- Queries for file_transfers table
insertFileTransfer:
INSERT INTO file_transfers (file_name, file_path, total_size, transferred_size, status)
VALUES (?, ?, ?, ?, ?);

lastInsertRowIdFileTransfer:
SELECT last_insert_rowid();

updateStatusAndSize:
UPDATE file_transfers
SET status = ?, transferred_size = ?
WHERE id = ?;

updateStatus:
UPDATE file_transfers
SET status = ?
WHERE id = ?;

getById:
SELECT *
FROM file_transfers
WHERE id = ?;

updateFilePath:
UPDATE file_transfers
SET file_path = ?
WHERE id = ?;
