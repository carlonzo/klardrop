CREATE TABLE file_transfers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    file_name TEXT NOT NULL,
    file_path TEXT NOT NULL,
    total_size INTEGER NOT NULL,
    transferred_size INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL, -- Enum: IN_PROGRESS, COMPLETED, FAILED
    mime_type TEXT NOT NULL DEFAULT 'application/octet-stream'
);

-- Queries for file_transfers table
insertFileTransfer:
INSERT INTO file_transfers (file_name, file_path, total_size, transferred_size, status, mime_type)
VALUES (?, ?, ?, ?, ?, ?);

lastInsertRowIdFileTransfer:
SELECT last_insert_rowid();

updateStatus:
UPDATE file_transfers
SET status = ?
WHERE id = ?;

getById:
SELECT *
FROM file_transfers
WHERE id = ?;

updateFilePath:
UPDATE file_transfers
SET file_path = ?
WHERE id = ?;