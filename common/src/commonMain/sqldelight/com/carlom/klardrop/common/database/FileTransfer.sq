CREATE TABLE file_transfers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL UNIQUE,
    file_name TEXT NOT NULL,
    file_path TEXT NOT NULL,
    total_size INTEGER NOT NULL,
    transferred_size INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL, -- Enum: IN_PROGRESS, COMPLETED, FAILED
    mime_type TEXT NOT NULL DEFAULT 'application/octet-stream'
);

-- Queries for file_transfers table
insertFileTransfer:
INSERT INTO file_transfers (uuid, file_name, file_path, total_size, transferred_size, status, mime_type)
VALUES (?, ?, ?, ?, ?, ?, ?);

getIdByUuid:
SELECT id
FROM file_transfers
WHERE uuid = ?
LIMIT 1;

updateStatus:
UPDATE file_transfers
SET status = ?
WHERE id = ?;

getById:
SELECT *
FROM file_transfers
WHERE id = ?;

updateFilePath:
UPDATE file_transfers
SET file_path = ?
WHERE id = ?;

-- Recover from a previous process death/crash mid-transfer: anything still flagged
-- IN_PROGRESS at app start can't actually be transferring anymore, so flip it to
-- FAILED. Bulk single-statement update so we don't pay one round-trip per row.
markStaleInProgressAsFailed:
UPDATE file_transfers
SET status = 'FAILED'
WHERE status = 'IN_PROGRESS';