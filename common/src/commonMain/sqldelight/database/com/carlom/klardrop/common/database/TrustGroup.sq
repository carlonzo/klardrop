-- Trust Groups table
CREATE TABLE trust_groups (
    group_id TEXT PRIMARY KEY NOT NULL,
    group_key BLOB NOT NULL,
    group_name TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    protocol_version INTEGER NOT NULL DEFAULT 1,
    cloud_sync_enabled INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1
);

-- Get the active trust group
getActiveTrustGroup:
SELECT * FROM trust_groups WHERE is_active = 1 LIMIT 1;


-- Insert or replace trust group
upsertTrustGroup:
INSERT OR REPLACE INTO trust_groups (
    group_id, group_key, group_name, created_at, updated_at, 
    protocol_version, cloud_sync_enabled, is_active
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Update group key
updateGroupKey:
UPDATE trust_groups SET group_key = ?, updated_at = ? WHERE group_id = ?;

-- Enable cloud sync
enableCloudSync:
UPDATE trust_groups SET cloud_sync_enabled = 1, updated_at = ? WHERE group_id = ?;

-- Deactivate all groups
deactivateAllGroups:
UPDATE trust_groups SET is_active = 0;

-- Delete trust group
deleteTrustGroup:
DELETE FROM trust_groups WHERE group_id = ?;