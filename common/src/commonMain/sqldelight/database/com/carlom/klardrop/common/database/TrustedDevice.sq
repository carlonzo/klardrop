-- Trusted Devices table
CREATE TABLE trusted_devices (
    device_id TEXT PRIMARY KEY NOT NULL,
    group_id TEXT NOT NULL,
    public_key BLOB NOT NULL,
    device_name TEXT NOT NULL,
    device_type TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    added_by TEXT NOT NULL,
    last_seen INTEGER,
    trust_level TEXT NOT NULL DEFAULT 'FULL',
    permissions TEXT NOT NULL, -- JSON array of permissions
    expires_at INTEGER,
    is_active INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (group_id) REFERENCES trust_groups(group_id) ON DELETE CASCADE
);

-- Get all trusted devices for a group
getTrustedDevicesByGroup:
SELECT * FROM trusted_devices WHERE group_id = ? AND is_active = 1;

-- Get trusted device by ID
getTrustedDeviceById:
SELECT * FROM trusted_devices WHERE device_id = ?;

-- Check if device is trusted
isDeviceTrusted:
SELECT COUNT(*) > 0 AS is_trusted FROM trusted_devices 
WHERE device_id = ? AND is_active = 1 
AND (expires_at IS NULL OR expires_at > ?);

-- Insert or replace trusted device
upsertTrustedDevice:
INSERT OR REPLACE INTO trusted_devices (
    device_id, group_id, public_key, device_name, device_type,
    added_at, added_by, last_seen, trust_level, permissions, 
    expires_at, is_active
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update last seen
updateLastSeen:
UPDATE trusted_devices SET last_seen = ? WHERE device_id = ?;

-- Remove trusted device
removeTrustedDevice:
UPDATE trusted_devices SET is_active = 0 WHERE device_id = ?;

-- Delete expired devices
deleteExpiredDevices:
DELETE FROM trusted_devices WHERE expires_at IS NOT NULL AND expires_at < ?;

-- Get device trust level
getDeviceTrustLevel:
SELECT trust_level FROM trusted_devices 
WHERE device_id = ? AND is_active = 1 
AND (expires_at IS NULL OR expires_at > ?);