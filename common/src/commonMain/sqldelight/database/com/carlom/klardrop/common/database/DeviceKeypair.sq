-- Device Keypair table (stores this device's identity)
CREATE TABLE device_keypair (
    id INTEGER PRIMARY KEY CHECK (id = 1), -- Ensure only one keypair
    device_id TEXT NOT NULL UNIQUE,
    public_key BLOB NOT NULL,
    private_key_alias TEXT NOT NULL, -- Reference to secure storage
    device_name TEXT NOT NULL,
    device_type TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

-- Get device keypair
getDeviceKeypair:
SELECT * FROM device_keypair WHERE id = 1;

-- Insert or replace device keypair
upsertDeviceKeypair:
INSERT OR REPLACE INTO device_keypair (
    id, device_id, public_key, private_key_alias, 
    device_name, device_type, created_at
) VALUES (1, ?, ?, ?, ?, ?, ?);

-- Update device name
updateDeviceName:
UPDATE device_keypair SET device_name = ? WHERE id = 1;

-- Delete device keypair
deleteDeviceKeypair:
DELETE FROM device_keypair;