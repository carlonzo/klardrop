#!/usr/bin/env bash
# Deactivates Klardrop Omarchy shell plugin and menu extensions for the current user.
set -euo pipefail

say()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m::\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] && die "Run this script as your normal user (not with sudo)."

PLUGIN_DEST="$HOME/.config/omarchy/plugins/klardrop.omarchy"
MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin disable klardrop.omarchy >/dev/null 2>&1 || true
  omarchy plugin remove klardrop.omarchy --yes >/dev/null 2>&1 || true
fi
if [ -d "$PLUGIN_DEST" ]; then
  mv "$PLUGIN_DEST" "$PLUGIN_DEST.bak.$(date -u +%s)"
fi

if [ -f "$MENU_FILE" ] && command -v perl >/dev/null 2>&1; then
  if grep -q '// BEGIN klardrop.omarchy' "$MENU_FILE" 2>/dev/null; then
    cp "$MENU_FILE" "$MENU_FILE.bak.$(date -u +%s)"
    perl -0pi -e 's/,?\s*\/\/ BEGIN klardrop\.omarchy.*?\/\/ END klardrop\.omarchy\n?/\n/s' "$MENU_FILE"
  fi
fi

say "Klardrop Omarchy integration disabled for $(whoami)."
