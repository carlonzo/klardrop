#!/usr/bin/env bash
# Activates Klardrop Omarchy shell plugin for the current user.
set -euo pipefail

say()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m::\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] && die "Run this script as your normal user (not with sudo)."

PLUGIN_SRC="/usr/share/klardrop/omarchy-plugin"
PLUGIN_DEST="$HOME/.config/omarchy/plugins/klardrop.omarchy"
MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

[ -d "$PLUGIN_SRC" ] || die "Missing $PLUGIN_SRC. Ensure klardrop-omarchy is installed."

say "Installing Omarchy plugin to $PLUGIN_DEST…"
mkdir -p "$(dirname "$PLUGIN_DEST")"
rm -rf "$PLUGIN_DEST"
cp -a "$PLUGIN_SRC" "$PLUGIN_DEST"

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

plugin_ok=1
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin enable klardrop.omarchy >/dev/null 2>&1 || plugin_ok=0
else
  plugin_ok=0
fi
if [ "$plugin_ok" != 1 ]; then
  warn "Could not enable klardrop.omarchy plugin automatically."
  warn "Run manually: omarchy plugin enable klardrop.omarchy"
fi

if [ -f "$MENU_FILE" ]; then
  if command -v perl >/dev/null 2>&1; then
    cp "$MENU_FILE" "$MENU_FILE.bak.$(date -u +%s)"
    perl -CSD -0pi -e '
      s/[ \t]*\/\/ BEGIN klardrop\.omarchy.*?\/\/ END klardrop\.omarchy\n?//s;
      my $pos = rindex($_, "}");
      die "no closing brace found in menu file\n" if $pos < 0;
      my $head = substr($_, 0, $pos);
      my $tail = substr($_, $pos);
      $head =~ s/[ \t\r\n]+\z//;
      $head .= "," if $head !~ /[{,]\z/;
      my $block = <<"BLOCK";
  // BEGIN klardrop.omarchy -- managed by klardrop-omarchy, do not edit by hand
  "trigger.share.klardrop": {"icon":"󰅟","label":"Klardrop panel","description":"Open the Klardrop quick panel","action":"omarchy-shell klardrop.omarchy toggle"}
  // END klardrop.omarchy
BLOCK
      $_ = $head . "\n" . $block . $tail;
    ' "$MENU_FILE" 2>/dev/null && say "Merged quick panel shortcut into $MENU_FILE." || warn "Failed to update $MENU_FILE."
  else
    warn "perl is not installed: skipping omarchy-menu shortcut integration."
    warn "Install perl and re-run to merge quick panel shortcut into $MENU_FILE."
  fi
fi

daemon_ok=1
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable --now klardrop.service >/dev/null 2>&1 || daemon_ok=0
else
  daemon_ok=0
fi
if [ "$daemon_ok" != 1 ]; then
  warn "Could not enable or start klardrop.service via systemd."
  warn "Run manually: systemctl --user enable --now klardrop.service"
fi

if [ "$plugin_ok" = 1 ] && [ "$daemon_ok" = 1 ]; then
  say "Klardrop Omarchy integration enabled for $(whoami)."
else
  warn "Klardrop Omarchy integration partially configured. See manual commands above."
fi
