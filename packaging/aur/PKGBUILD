# Maintainer: Carlo Marinangeli <carlo.marinangeli@gmail.com>
#
# This is a TEMPLATE. The release workflow renders @PKGVER@ and @SHA256@ from the
# git tag and the tarball checksum, regenerates .SRCINFO, and pushes the result to
# the AUR (`klardrop-bin`). To test locally: replace the two placeholders by hand,
# point source[0] at a real release tarball, then run `makepkg -si`.

pkgname=klardrop-bin
_appname=klardrop
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Share files and clipboard with nearby devices over the local network (AirDrop-style)"
arch=('x86_64')
url="https://github.com/carlonzo/klardrop"
license=('Apache-2.0')
# The tarball bundles its own JRE (jpackage app-image), so no java runtime dependency.
# These are the shared libraries the bundled Skiko/AWT stack dlopen()s at runtime.
depends=('hicolor-icon-theme' 'fontconfig' 'gtk3')
provides=('klardrop')
conflicts=('klardrop')
options=('!strip')
source=("klardrop-linux-x64-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/klardrop-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "$srcdir/klardrop-linux-x64"

  # App-image (bin/ launcher + lib/ with bundled JRE) lives under /opt; jpackage
  # images are relocatable as long as the bin/lib structure is preserved.
  install -d "$pkgdir/opt"
  cp -r klardrop "$pkgdir/opt/klardrop"

  # Launcher on PATH.
  install -d "$pkgdir/usr/bin"
  ln -s /opt/klardrop/bin/klardrop "$pkgdir/usr/bin/klardrop"

  # Desktop entry + AppStream metadata.
  install -Dm644 klardrop.desktop \
    "$pkgdir/usr/share/applications/klardrop.desktop"
  install -Dm644 com.carlom.Klardrop.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.carlom.Klardrop.metainfo.xml"

  # Hicolor icons at every size shipped in the tarball (icons/<size>/klardrop.png).
  for icon in icons/*/klardrop.png; do
    size=$(basename "$(dirname "$icon")")
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size}/apps/klardrop.png"
  done
}
